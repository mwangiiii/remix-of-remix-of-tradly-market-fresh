# Copy to .env and fill in.
# Shared Supabase project — same as tradly-flow / tradly-super-admin (see C:\Projects\tradly\CLAUDE.md).
VITE_SUPABASE_URL=https://fcbmxacyxioknoyajodc.supabase.co
VITE_SUPABASE_ANON_KEY=

# Public origin used for canonical URLs, og:url, sitemap loc, JSON-LD.
# Change per deployment; no trailing slash.
VITE_SITE_URL=https://market.tradly.co.ke

# GA4 Measurement ID (format G-XXXXXXXXXX). Leave empty until provisioned;
# analytics no-ops cleanly with no ID set.
VITE_GA4_ID=

# ─── Household Commerce checkout (spec Checkpoint E) ────────────────────
# Paystack lives entirely server-side: the Edge Function
# `consumer-order-init` initializes the transaction with PAYSTACK_SECRET_KEY
# (a tradly-flow secret, NOT set here) and returns an authorization_url.
# The browser redirects to that URL — no client-side Paystack SDK, so no
# VITE_PAYSTACK_PUBLIC_KEY is required at launch.
#
# Add VITE_PAYSTACK_PUBLIC_KEY here later if we switch to Paystack Inline
# for a same-page checkout experience.
