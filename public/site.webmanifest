{
  "name": "Tradly Market",
  "short_name": "Tradly",
  "description": "Fresh produce and food-service essentials for Kenyan kitchens. Same-day dispatch in Nairobi, next-day across Kiambu and near Machakos, and 1–3 days across Kirinyaga, Murang'a, Nyeri, Nyandarua, Embu, Nakuru, Laikipia and Uasin Gishu.",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#FAFAF8",
  "theme_color": "#FAFAF8",
  "lang": "en-KE",
  "dir": "ltr",
  "categories": ["food", "shopping", "business"],
  "icons": [
    { "src": "/favicon.svg",           "sizes": "any",     "type": "image/svg+xml", "purpose": "any" },
    { "src": "/favicon-32x32.png",     "sizes": "32x32",   "type": "image/png" },
    { "src": "/favicon-16x16.png",     "sizes": "16x16",   "type": "image/png" },
    { "src": "/apple-touch-icon.png",  "sizes": "180x180", "type": "image/png" },
    { "src": "/icon-192.png",          "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png",          "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Browse the market",
      "short_name": "Browse",
      "url": "/",
      "description": "See today's fresh picks and reorder essentials."
    },
    {
      "name": "Your cart",
      "short_name": "Cart",
      "url": "/cart",
      "description": "Review the items in your cart before checkout."
    },
    {
      "name": "Saved lists",
      "short_name": "Lists",
      "url": "/lists",
      "description": "Reorder from your saved procurement lists."
    }
  ]
}
